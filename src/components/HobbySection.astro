---
import type { HobbyItem } from '../data/about';

interface Props {
  items: HobbyItem[];
}

const { items } = Astro.props;
---

<div class="hobby-grid">
  {
    items.map((item) => (
      <div class="hobby-cell">
        <h5 class="hobby-name">{item.name}</h5>
        {item.note && <p class="hobby-note">{item.note}</p>}
      </div>
    ))
  }
</div>
