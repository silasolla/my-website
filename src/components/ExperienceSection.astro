---
import type { ExperienceItem } from '../data/about';

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<div class="experience-list">
  {
    items.map((item) => (
      <div class="row">
        <div class="row-meta">{item.period}</div>
        <div class="row-body">
          <a href={item.companyLink} target="_blank" rel="noopener noreferrer" class="row-title">
            {item.company}
          </a>
          <p class="row-sub">{item.role}</p>
          {item.description && <p class="row-desc">{item.description}</p>}
        </div>
      </div>
    ))
  }
</div>
