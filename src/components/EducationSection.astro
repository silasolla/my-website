---
import type { EducationItem } from '../data/about';

interface Props {
  items: EducationItem[];
}

const { items } = Astro.props;
---

<div class="education-list">
  {
    items.map((item) => (
      <div class="row">
        <div class="row-meta">{item.period}</div>
        <div class="row-body">
          <h4 class="row-title">{item.institution}</h4>
          {item.degree && <p class="row-sub">{item.degree}</p>}
          {item.description && <p class="row-desc">{item.description}</p>}
        </div>
      </div>
    ))
  }
</div>
