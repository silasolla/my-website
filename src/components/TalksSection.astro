---
import { getCollection } from 'astro:content';
import type { TalkItem } from '../data/about';
import { getTranslation } from '../i18n/translations';
import { findCounterpartPost } from '../utils/posts';
import { postsBasePath } from '../utils/paths';

interface Props {
  items: TalkItem[];
}

const { items } = Astro.props;
const eventLabel = getTranslation(Astro.currentLocale, 'talks.event');
const slidesLabel = getTranslation(Astro.currentLocale, 'talks.slides');
const postLabel = getTranslation(Astro.currentLocale, 'talks.post');

// 対訳がないロケールでは記事が存在する言語 (ja) のページへリンクする
const posts = await getCollection('posts');
const targetLang = Astro.currentLocale === 'en' ? 'en' : 'ja';
function postHref(slug: string): string {
  const target = findCounterpartPost(posts, slug, targetLang);
  return target ? `${postsBasePath(targetLang)}/${target.id}/` : `/posts/${slug}/`;
}

function resolveLinks(item: TalkItem) {
  const all = [
    item.postSlug ? { href: postHref(item.postSlug), label: postLabel, external: false } : null,
    item.slideUrl ? { href: item.slideUrl, label: slidesLabel, external: true } : null,
    item.eventUrl ? { href: item.eventUrl, label: eventLabel, external: true } : null,
  ].filter((link) => link !== null);
  return { primary: all[0], rest: all.slice(1) };
}
---

<div class="row-list">
  {
    items.map((item) => {
      const { primary, rest } = resolveLinks(item);
      const externalAttrs = { target: '_blank', rel: 'noopener noreferrer' };

      return (
        <article class="row">
          <div class="row-meta">{item.date}</div>
          <div class="row-body">
            {primary ? (
              <a href={primary.href} class="row-title" {...(primary.external ? externalAttrs : {})}>
                {item.title}
              </a>
            ) : (
              <h4 class="row-title">{item.title}</h4>
            )}
            <p class="row-sub">{item.event}</p>
            {item.description && <p class="row-desc">{item.description}</p>}
            {rest.length > 0 && (
              <div class="row-actions">
                {rest.map((link) => (
                  <a href={link.href} class="row-action" {...(link.external ? externalAttrs : {})}>
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      );
    })
  }
</div>
