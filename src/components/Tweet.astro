---
import '../styles/tweet.css';

export interface Props {
  id: string;
  user?: string;
}

const { id, user } = Astro.props;
---

<div class="tweet-container">
  <blockquote class="twitter-tweet" data-dnt="true" data-theme="light">
    <a href={`https://twitter.com/${user || 'x'}/status/${id}`}></a>
  </blockquote>
</div>

<script>
  // widgets.js はレンダリング済みの埋め込みを再テーマできないため，
  // テーマの反映は widgets.js 読み込み前の一度きり
  const isDarkMode = document.documentElement.getAttribute('data-theme') === 'dark';
  document.querySelectorAll('.twitter-tweet').forEach((tweet) => {
    tweet.setAttribute('data-theme', isDarkMode ? 'dark' : 'light');
  });

  // widgets.js が未読み込み (window.twttr が無い) のときだけ注入する
  if (!('twttr' in window)) {
    const script = document.createElement('script');
    script.src = 'https://platform.twitter.com/widgets.js';
    script.async = true;
    document.body.appendChild(script);
  }
</script>
