---
import type { CertificationCategory } from '../data/about';

interface Props {
  categories: CertificationCategory[];
}

const { categories } = Astro.props;
---

<div class="certification-categories">
  {
    categories.map((category) => (
      <div class="category">
        <h4 class="category-name">{category.category}</h4>
        <div class="cert-grid">
          {category.items.map((item) => {
            const CellTag = item.credlyUrl ? 'a' : 'div';
            const cellProps = item.credlyUrl
              ? {
                  href: item.credlyUrl,
                  target: '_blank',
                  rel: 'noopener noreferrer',
                  class: 'cert-cell',
                }
              : { class: 'cert-cell' };

            return (
              <CellTag {...cellProps}>
                <span class="cert-badge">
                  {item.badgeImage && <img src={item.badgeImage} alt="" />}
                </span>
                <span class="cert-name">{item.name}</span>
              </CellTag>
            );
          })}
        </div>
      </div>
    ))
  }
</div>
