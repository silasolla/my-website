---
import type { MiscCategory } from '../data/about';

interface Props {
  categories: MiscCategory[];
}

const { categories } = Astro.props;
---

<div class="misc-container">
  {
    categories.map((category) => (
      <div class="misc-category">
        <h4 class="category-title">{category.category}</h4>
        <div class="row-list">
          {category.items.map((item) => {
            const RowTag = item.url ? 'a' : 'div';
            const rowProps = item.url
              ? {
                  href: item.url,
                  target: '_blank',
                  rel: 'noopener noreferrer',
                  class: 'row row--flat',
                }
              : { class: 'row row--flat' };

            return (
              <RowTag {...rowProps}>
                <div class="row-body">
                  <h5 class="row-title">{item.name}</h5>
                  {item.description && <p class="row-desc">{item.description}</p>}
                </div>
              </RowTag>
            );
          })}
        </div>
      </div>
    ))
  }
</div>
