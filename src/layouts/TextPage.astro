---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <p><a href="/text/">記事一覧</a> | <a href="/">通常版</a></p>
    <hr />
    <slot />
  </body>
</html>
